    const isReleaseFlagUnlocked = (unlock) => {
        if (unlock.type === 1 && unlock.permitIndex !== undefined) {
            return (minigamePermitFlags & (1 << unlock.permitIndex)) !== 0;
        }
        if (unlock.flagIndex !== undefined) {
            const byteOffset = 290 + Math.floor(unlock.flagIndex / 8);
            const bitPos = 7 - (unlock.flagIndex % 8);
            const byteVal = lpac01Bindata[byteOffset] ?? 0;
            return (byteVal & (1 << bitPos)) !== 0;
        }
        return false;
    };

    const firstPerson = lpac01Bindata[354] ?? 0;
    const callsHer = lpac01Bindata[355] ?? 0;
    const nicknameId3dsRaw = (
        ((lpac01Bindata[360] ?? 255) << 24) |
        ((lpac01Bindata[361] ?? 255) << 16) |
        ((lpac01Bindata[362] ?? 255) << 8) |
        (lpac01Bindata[363] ?? 255)
    );
    const nicknameId3ds = (nicknameId3dsRaw === -1 || nicknameId3dsRaw === 0xFFFFFFFF) ? -1 : nicknameId3dsRaw;

    const collaborateCode = lpac01Bindata[340] ?? 0;
    const arMarkerCodeRaw = (
        ((lpac01Bindata[345] ?? 255) << 24) |
        ((lpac01Bindata[346] ?? 255) << 16) |
        ((lpac01Bindata[347] ?? 255) << 8) |
        (lpac01Bindata[348] ?? 255)
    ) >>> 0;
    const isArLinked = collaborateCode === 2 && arMarkerCodeRaw !== 0xFFFFFFFF;
    const savedArCode = isArLinked ? arMarkerCodeRaw : 0;
    const savedHairType = ((lpac01Bindata[350] ?? 0) << 8) | (lpac01Bindata[351] ?? 0);

div
    .card
        .card-header
            p.card-header-title
                span.icon
                    i.mdi.mdi-account-edit
                | Player Profile
        .card-content
            form
                .profile-data-section
                    h2.title.is-5 Player Information (strdata)

                    .field
                        label.label Reference ID
                        .control
                            input.input(type="text" id="refid" name="refid", value=refid readonly)

                    .field
                        label.label Name
                        .field.has-addons
                            .control.is-expanded
                                input.input(type="text" id="name" name="name", value=playerName)
                            .control
                                button.button.is-light#fullwidth-name-button(type="button" title="Convert ASCII characters to full-width")
                                    span.icon
                                        i.mdi.mdi-format-letter-case
                                    span Full-width

                    .field
                        label.label Birthday
                        .control
                            .select
                                select#birth-month(name="birth_month")
                                    option(value="") Select Birth Month
                                    each month in ["01","02","03","04","05","06","07","08","09","10","11","12"]
                                        option(value=month selected=(birthMonth === month)) #{month}
                            .select
                                select#birth-day(name="birth_day", data-default=birthDay)
                                    option(value="") Select Birth Day
                                    each day in [...Array(31).keys()].map(d => String(d+1).padStart(2, '0'))
                                        option(value=day selected=(birthDay === day)) #{day}

                    .field
                        label.label Blood Type
                        .control
                            .select
                                select#blood-type(name="blood_type")
                                    option(value="") Select Blood Type
                                    each bloodTypeOption in ["A", "B", "O", "AB"]
                                        option(value=bloodTypeOption selected=(bloodType === bloodTypeOption)) #{bloodTypeOption}

                    .field
                        label.label Reading
                        .control
                            input.input(type="text" id="reading" name="reading", value=playerReading)
                        p#reading-kana.help(class=playerReadingKana ? "" : "is-danger")= "Current Reading: " + (playerReadingKana || "Unknown Reading ID")  

                    .field
                        label.label Girlfriend
                        .control
                            .select
                                select#girlfriend(name="girlfriend")
                                    option(value="") Select Girlfriend
                                    each girlfriendOption in ["Manaka", "Rinko", "Nene"]
                                        option(value=girlfriendOption selected=(selectedGirlfriend === girlfriendOption)) #{girlfriendOption}

                    .field
                        label.label User Agreement Status
                        .control
                            .select
                                select#user-agreement(name="user_agreement")
                                    option(value="") Select Agreement Status
                                    each agreementStatus in ["Not Agreed", "Agreed"]
                                        option(value=agreementStatus selected=(userAgreementStatus === agreementStatus)) #{agreementStatus}
                        p.help.is-danger If you have not agreed to the User Agreement, the game will require you to re-enter all information.

                hr

                .profile-data-section
                    h2.title.is-5 Player Data (bindata)

                    .field
                        label.label Date Level
                        .control
                            input.input(type="number" id="date-level" name="date_level" min="0" max="50" value=dateLevel)
                        p.help Maximum Date Level: 50.

                    .field
                        label.label Date Level Exp
                        .control
                            input.input(type="number" id="date-level-exp" name="date_level_exp" min="0" max="150" value=dateLevelExp)
                        p.help Maximum Date Level Exp: 150.

                    .field
                        label.label Release Unlock Status (全解禁ステータス)
                        .box.has-background-white-ter.p-3(style="max-height: 380px; overflow-y: auto; border: 1px solid #dbdbdb; border-radius: 6px;")
                            .columns.is-multiline.is-variable.is-1
                                each unlock in releaseUnlocks
                                    .column.is-half(style="padding: 4px 8px;")
                                        .field.is-narrow(style="margin-bottom: 0;")
                                            .control(style="display: flex; align-items: center;")
                                                label.radio(style="display: flex; align-items: center; cursor: default; width: 100%;")
                                                    input.release-unlock(type="radio" id='unlock-' + unlock.id name='unlock_status_' + unlock.id data-unlock-level=unlock.level checked=isReleaseFlagUnlocked(unlock) disabled style="margin-right: 8px; flex-shrink: 0;")
                                                    span.tag.is-info.is-light.is-small(style="margin-right: 8px; min-width: 48px; text-align: center; flex-shrink: 0;") Lv.#{unlock.level}
                                                    span.is-size-7(style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title=unlock.name_en + ' (' + unlock.name_ja + ')')
                                                        strong #{unlock.name_en}
                                                        span.has-text-grey  (#{unlock.name_ja})
                        p.help All 52 release unlock flags (Minigames, Fashion Show Poses, Mystery Roulette Additions, Presents, Base Tension Increase, Casual Sitting Fashion Show) are automatically synchronized with changes to your Date Level.

                    .field
                        label.label Minigame Levels
                        .columns.is-multiline
                            each index in knownMinigameIndices
                                - const minigameLabel = minigameNames[index]
                                - const minigameId = 'level-minigame-' + index
                                .column.is-half
                                    label.label.is-small= minigameLabel
                                    .control
                                        input.input.minigame-level(type="number" id=minigameId min="1" max="99" data-slot=index value=bindataLevel(44 + index))
                    .field
                        label.label Costume Unlock Status
                        .control
                            label.checkbox
                                - const bindata = profile.usergamedata["LPAC01"]["bindata"];
                                - const isDressesUnlocked = bindata[50] === 0xFF && bindata[51] === 0xFF && bindata[52] === 0xFF && bindata[53] === 0xFF;
                                input#unlock-all-dresses(type="checkbox" checked=isDressesUnlocked)
                                |  Unlock All Costumes

                hr

                .profile-data-section
                    h2.title.is-5 🗣️ Nintendo 3DS Sync

                    .field
                        label.label First Person (一人称)
                        .control
                            .select
                                select#first-person(name="first_person")
                                    option(value="0" selected=(firstPerson === 0)) Boku (僕)
                                    option(value="1" selected=(firstPerson === 1)) Ore (俺)
                        p.help Player's first-person pronoun in dialogue.

                    .field
                        label.label Calls Her (彼女の呼び方)
                        .control
                            .select
                                select#calls-her(name="calls_her" data-current=callsHer)
                                    option(value=callsHer) Loading...
                        p.help How player addresses their girlfriend in dialogue.

                    .field
                        label.label 3DS Nickname (彼氏の呼び方)
                        .field.has-addons
                            .control.is-expanded
                                .select.is-fullwidth
                                    select#nickname-preset
                                        option(value="-1") Default Base Reading
                                        option(value="958") Darling (ダーリン)
                                        option(value="966") Senpai (先輩)
                                        option(value="964") Onii-chan (おにいちゃん)
                                        option(value="2945") Nii-san (にいさん)
                                        option(value="2940") Onii-sama (お兄様)
                                        option(value="963") Otouto-kun (おとうと君)
                                        option(value="2948") Ouji-sama (王子様)
                                        option(value="2939") Master (マスター)
                                        option(value="965") Goshujin-sama (ご主人様)
                                        option(value="967") Danna-sama (だんな様)
                                        option(value="2943") Papa (パパ)
                                        option(value="2944") Honey (ハニー)
                                        option(value="2942") Sensei (先生)
                                        option(value="2941") Kakka (閣下)
                                        option(value="959") Kimi (キミ)
                                        option(value="960") Anata (あなた)
                                        option(value="custom") Custom Table 2 ID...

                            .control
                                input.input#nickname-id(type="number" min="-1" max="5503" value=nicknameId3ds style="width: 140px" placeholder="ID (-1 ~ 5503)")
                        p#nickname-preview.help.has-text-info Current Nickname: Loading...

                hr

                .profile-data-section
                    h2.title.is-5 💇 Nintendo DS Sync

                    .field
                        .control
                            label.checkbox
                                input#override-hairstyle(type="checkbox" checked=isArLinked)
                                strong  Override Hairstyle
                        p.help Writes hairstyle AR Marker info directly into save data.

                    #hairstyle-controls(data-saved-ar=savedArCode data-saved-type=savedHairType style=isArLinked ? "" : "display: none; margin-top: 1rem;")
                        .columns
                            .column.is-one-third
                                .field
                                    label.label Hair Length (髪の長さ)
                                    .control
                                        .select.is-fullwidth
                                            select#hair-length
                                                option(value="0") Long (ロング)
                                                option(value="1") Middle (ミドル)
                                                option(value="2") Short (ショート)
                            .column.is-one-third
                                .field
                                    label.label Hair Style (髪型)
                                    .control
                                        .select.is-fullwidth
                                            select#hair-style
                            .column.is-one-third
                                .field
                                    label.label Hair Color (髪色)
                                    .control
                                        .select.is-fullwidth
                                            select#hair-color
                                    p#color-detail-badge.help(style="display: flex; align-items: center; margin-top: 6px;")
                                        span#color-swatch-dot(style="display: inline-block; width: 14px; height: 14px; border-radius: 3px; border: 1px solid rgba(0,0,0,0.2); margin-right: 6px;")
                                        span#color-rgb-text.has-text-grey Loading...

                        .field.mt-3
                            label.label.is-size-7 Color Reference
                            #color-swatches-grid(style="display: flex; flex-wrap: wrap; gap: 8px; padding: 10px; background: #f9fafb; border-radius: 6px; border: 1px solid #e5e7eb; max-height: 280px; overflow-y: auto;")

                        .notification.is-info.is-light.p-3.mt-3(style="border-left: 4px solid #3273dc;")
                            p.has-text-weight-bold.is-size-7 Notes
                            ul.is-size-7.mt-1.ml-4(style="list-style: disc;")
                                li
                                    strong Rinko
                                    span : Default color is 
                                    strong Natural Brown / Dark Brown B (自然な茶系／黒っぽい Ｂ)
                                    span .
                                li
                                    strong Manaka
                                    span : Default color is 
                                    strong Black (黒)
                                    span .
                                li
                                    strong Nene
                                    span : Default color is 
                                    strong Natural Brown / Yellow B (自然な茶系／黄色っぽい Ｂ)
                                    span .
                                li
                                    span Different girlfriends may have different hair colors with the same color ID.


                        .box.has-background-light.p-3.mt-3
