//DATA//
    profile: DB.FindOne(refid, { collection: 'profile' })
-
    const playerName = profile.usergamedata["LPAC00"]["strdata"][27];
    const playerPronunciation = profile.usergamedata["LPAC00"]["strdata"][4];

    const birthdayBloodType = profile.usergamedata["LPAC00"]["strdata"][5];
    const birthMonthHex = birthdayBloodType[0];
    const birthDayHex = birthdayBloodType.slice(1, 3);
    const bloodTypeHex = birthdayBloodType.slice(3, 5);

    const birthMonthMap = {
        '1': '01', '2': '02', '3': '03', '4': '04', '5': '05', '6': '06',
        '7': '07', '8': '08', '9': '09', 'a': '10', 'b': '11', 'c': '12'
    };

    const bloodTypeMap = {
        '00': 'A', '01': 'B', '02': 'O', '03': 'AB'
    };

    const birthMonth = birthMonthMap[birthMonthHex.toLowerCase()];
    const birthDay = parseInt(birthDayHex, 16).toString(10).padStart(2, '0');
    const bloodType = bloodTypeMap[bloodTypeHex.toLowerCase()];

    const girlfriendId = profile.usergamedata["LPAC00"]["strdata"][6];
    let selectedGirlfriend = '';
    switch (girlfriendId) {
        case '0':
            selectedGirlfriend = "Manaka";
            break;
        case '10000':
            selectedGirlfriend = "Rinko";
            break;
        case '20000':
            selectedGirlfriend = "Nene";
            break;
        default:
            selectedGirlfriend = "Manaka";
            break;
    }

    const userAgreement = profile.usergamedata["LPAC00"]["strdata"][3];
    let userAgreementStatus = '';
    switch (userAgreement) {
        case '0':
            userAgreementStatus = "Not Agreed";
            break;
        case '2f':
            userAgreementStatus = "Agreed";
            break;
    }

div
    .card
        .card-header
            p.card-header-title
                span.icon
                    i.mdi.mdi-account-edit
                | Player Profile
        .card-content
            form
                .field
                    label.label Reference ID
                    .control
                        input.input(type="text" id="refid" name="refid", value=refid readonly)

                .field
                    label.label Name
                    .control
                        input.input(type="text" id="name" name="name", value=playerName)

                .field
                    label.label Birthday
                    .control
                        .select
                            select#birth-month(name="birth_month")
                                option(value="") Select Birth Month
                                each month in ["01","02","03","04","05","06","07","08","09","10","11","12"]
                                    option(value=month selected=(birthMonth === month)) #{month}
                        .select
                            select#birth-day(name="birth_day", data-default=birthDay)
                                option(value="") Select Birth Day
                                each day in [...Array(31).keys()].map(d => String(d+1).padStart(2, '0'))
                                    option(value=day selected=(birthDay === day)) #{day}

                .field
                    label.label Blood Type
                    .control
                        .select
                            select#blood-type(name="blood_type")
                                option(value="") Select Blood Type
                                each bloodTypeOption in ["A", "B", "O", "AB"]
                                    option(value=bloodTypeOption selected=(bloodType === bloodTypeOption)) #{bloodTypeOption}

                .field
                    label.label Pronunciation
                    .control
                        input.input(type="text" id="pronunciation" name="pronunciation", value=playerPronunciation)
                    p.help.is-danger Pronunciation format is not fully documented. Verify the value in-game after saving.

                .field
                    label.label Girlfriend
                    .control
                        .select
                            select#girlfriend(name="girlfriend")
                                option(value="") Select Girlfriend
                                each girlfriendOption in ["Manaka", "Rinko", "Nene"]
                                    option(value=girlfriendOption selected=(selectedGirlfriend === girlfriendOption)) #{girlfriendOption}

                .field
                    label.label User Agreement Status
                    .control
                        .select
                            select#user-agreement(name="user_agreement")
                                option(value="") Select Agreement Status
                                each agreementStatus in ["Not Agreed", "Agreed"]
                                    option(value=agreementStatus selected=(userAgreementStatus === agreementStatus)) #{agreementStatus}
                    p.help.is-danger If you do not agree, the game will ask you to enter your player information again.

                .field
                    button.button.is-primary#submit-button(type="button") 
                        span.icon
                            i.mdi.mdi-check
                        span Save Profile

script(src="static/js/profile_detail.js")
